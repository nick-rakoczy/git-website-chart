{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["site", "gitCredentials"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "site": {
      "type": "object",
      "required": ["repository", "revision", "indexFile"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "indexFile": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "image", "workingDirectory", "command", "outputDirectory", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "image": {
            "type": "object",
            "required": ["repository", "tag", "pullPolicy"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "tag": { "type": "string", "minLength": 1 },
              "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
            }
          },
          "workingDirectory": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "outputDirectory": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "resources": { "type": "object" },
          "securityContext": { "type": "object" }
        }
      }
    },
    "git": {
      "type": "object",
      "required": ["image", "depth", "disableSubmodules"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "depth": { "type": "integer", "minimum": 0 },
        "disableSubmodules": { "type": "boolean" },
        "resources": { "type": "object" },
        "securityContext": { "type": "object" }
      }
    },
    "publishImage": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "gitCredentials": {
      "type": "object",
      "required": ["authentication", "privateKeyKey", "knownHostsKey", "githubApp", "onePassword"],
      "properties": {
        "authentication": { "type": "string", "enum": ["ssh", "githubApp"] },
        "secretName": { "type": "string" },
        "privateKeyKey": { "type": "string", "minLength": 1 },
        "knownHostsKey": { "type": "string", "minLength": 1 },
        "githubApp": {
          "type": "object",
          "required": ["applicationIdKey", "installationIdKey", "privateKeyKey"],
          "properties": {
            "applicationIdKey": { "type": "string", "minLength": 1 },
            "installationIdKey": { "type": "string", "minLength": 1 },
            "privateKeyKey": { "type": "string", "minLength": 1 }
          }
        },
        "onePassword": {
          "type": "object",
          "required": ["enabled", "itemPath"],
          "properties": {
            "enabled": { "type": "boolean" },
            "itemPath": { "type": "string" },
            "annotations": { "type": "object" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "onePassword": {
                "properties": { "enabled": { "const": true } }
              }
            }
          },
          "then": {
            "properties": {
              "onePassword": {
                "properties": { "itemPath": { "minLength": 1 } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "onePassword": {
                "properties": { "enabled": { "const": false } }
              }
            }
          },
          "then": {
            "properties": { "secretName": { "minLength": 1 } }
          }
        }
      ]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" }
      }
    }
  }
}
