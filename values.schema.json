{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["site", "gitCredentials"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "site": {
      "type": "object",
      "required": ["repository", "revision", "indexFile"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "indexFile": { "type": "string", "minLength": 1 }
      }
    },
    "gitCredentials": {
      "type": "object",
      "required": ["secretName", "privateKeyKey", "knownHostsKey"],
      "properties": {
        "secretName": { "type": "string", "minLength": 1 },
        "privateKeyKey": { "type": "string", "minLength": 1 },
        "knownHostsKey": { "type": "string", "minLength": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" }
      }
    }
  }
}

