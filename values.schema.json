{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["site", "persistence", "pipeline", "triggers", "gitCredentials"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "site": {
      "type": "object",
      "required": ["repository", "revision", "indexFile"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "indexFile": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "image", "workingDirectory", "command", "outputDirectory", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "image": { "$ref": "#/definitions/image" },
          "workingDirectory": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "outputDirectory": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "resources": { "type": "object" },
          "securityContext": { "type": "object" }
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["existingClaim", "accessModes", "size", "retain"],
      "properties": {
        "existingClaim": { "type": "string" },
        "storageClassName": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" },
        "retain": { "type": "boolean" }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["serviceAccount", "nodeSelector", "tolerations", "affinity", "podSecurityContext", "git", "publishImage", "timeouts"],
      "properties": {
        "serviceAccount": {
          "type": "object",
          "required": ["create", "name", "annotations"],
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "annotations": { "type": "object" }
          }
        },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "git": {
          "type": "object",
          "required": ["image", "depth", "disableSubmodules"],
          "properties": {
            "image": { "$ref": "#/definitions/image" },
            "depth": { "type": "integer", "minimum": 0 },
            "disableSubmodules": { "type": "boolean" }
          }
        },
        "publishImage": { "$ref": "#/definitions/image" },
        "timeouts": {
          "type": "object",
          "required": ["pipeline", "tasks", "finally"],
          "properties": {
            "pipeline": { "type": "string", "minLength": 2 },
            "tasks": { "type": "string", "minLength": 2 },
            "finally": { "type": "string", "minLength": 2 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "serviceAccount": { "properties": { "create": { "const": false } } } } },
          "then": { "properties": { "serviceAccount": { "properties": { "name": { "minLength": 1 } } } } }
        }
      ]
    },
    "triggers": {
      "type": "object",
      "required": ["enabled", "namespace", "serviceAccount", "github"],
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "serviceAccount": {
          "type": "object",
          "required": ["create", "name", "annotations"],
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "annotations": { "type": "object" }
          }
        },
        "github": {
          "type": "object",
          "required": ["branch", "endpoint", "webhookSecret", "ingress"],
          "properties": {
            "branch": { "type": "string", "minLength": 1 },
            "endpoint": { "type": "string", "pattern": "^/" },
            "webhookSecret": {
              "type": "object",
              "required": ["name", "key"],
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "ingress": {
              "type": "object",
              "required": ["enabled", "className", "annotations", "hostname", "pathType", "tls"],
              "properties": {
                "enabled": { "type": "boolean" },
                "className": { "type": "string" },
                "annotations": { "type": "object" },
                "hostname": { "type": "string" },
                "pathType": { "enum": ["Exact", "Prefix", "ImplementationSpecific"] },
                "tls": {
                  "type": "object",
                  "required": ["enabled", "secretName"],
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "secretName": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "serviceAccount": { "properties": { "create": { "const": false } } } } },
          "then": { "properties": { "serviceAccount": { "properties": { "name": { "minLength": 1 } } } } }
        },
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "properties": {
              "github": {
                "properties": {
                  "webhookSecret": { "properties": { "name": { "minLength": 1 } } },
                  "ingress": {
                    "allOf": [
                      {
                        "if": { "properties": { "enabled": { "const": true } } },
                        "then": { "properties": { "hostname": { "minLength": 1 } } }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "gitCredentials": {
      "type": "object",
      "required": ["authentication", "privateKeyKey", "knownHostsKey", "githubApp", "onePassword"],
      "properties": {
        "authentication": { "type": "string", "enum": ["ssh", "githubApp"] },
        "secretName": { "type": "string" },
        "privateKeyKey": { "type": "string", "minLength": 1 },
        "knownHostsKey": { "type": "string", "minLength": 1 },
        "githubApp": {
          "type": "object",
          "required": ["applicationIdKey", "installationIdKey", "privateKeyKey"],
          "properties": {
            "applicationIdKey": { "type": "string", "minLength": 1 },
            "installationIdKey": { "type": "string", "minLength": 1 },
            "privateKeyKey": { "type": "string", "minLength": 1 }
          }
        },
        "onePassword": {
          "type": "object",
          "required": ["enabled", "itemPath", "annotations"],
          "properties": {
            "enabled": { "type": "boolean" },
            "itemPath": { "type": "string" },
            "annotations": { "type": "object" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "onePassword": { "properties": { "enabled": { "const": true } } } } },
          "then": { "properties": { "onePassword": { "properties": { "itemPath": { "minLength": 1 } } } } }
        }
      ]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
